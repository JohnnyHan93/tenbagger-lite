# Server only. Do not prefix with VITE_ — that would leak to the browser.
# Leave DATABASE_URL empty in local preview (PGLite).
# Production Vercel must inject Neon. Without it, analysis writes fail instead of vanishing.
DATABASE_URL=

# Optional. App boots in manual mode without it.
XAI_API_KEY=

# Optional market data provider. Yahoo/Naver public pages are used if unset.
MARKET_DATA_API_KEY=

# Optional shared password. Empty = no gate.
APP_ACCESS_PASSWORD=

# Dev only. Allows production-like Vercel to write to ephemeral PGLite.
# IDT_ALLOW_EPHEMERAL=1
